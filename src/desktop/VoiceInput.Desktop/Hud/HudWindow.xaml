<Window x:Class="VoiceInput.Desktop.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Input"
        Width="440"
        Height="86"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Border Background="#F21D2024"
            BorderBrush="#45515B"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,11">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="AccentDot"
                     Width="9"
                     Height="9"
                     VerticalAlignment="Top"
                     Margin="0,5,0,0"
                     Fill="#37D67A" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StatusText"
                           Foreground="#F5F7F8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="Listening" />
                <TextBlock x:Name="TranscriptText"
                           Margin="0,5,0,0"
                           Foreground="#D6DBDF"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           Text="Speak now" />
            </StackPanel>
            <Button x:Name="DismissErrorButton"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Visibility="Hidden"
                    Focusable="False"
                    IsTabStop="False"
                    ToolTip="Close error"
                    AutomationProperties.Name="Close error"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Foreground="#D6DBDF"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="&#xE711;"
                    Click="OnDismissError">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#45515B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#59636B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
